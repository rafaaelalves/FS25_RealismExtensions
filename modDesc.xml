<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<modDesc descVersion="113">
    <author>Realism Extensions</author>
    <version>0.0.1.0</version>
    <title>
        <en>Realism Extensions</en>
        <br>Extensões de Realismo</br>
    </title>
    <description>
        <en><![CDATA[Experimental modular realism extensions that add missing physical and environmental consequences while preserving specialist-mod ownership. Terrain deformation/recovery is currently under active development.]]></en>
        <br><![CDATA[Extensões modulares experimentais de realismo que adicionam consequências físicas e ambientais ausentes, preservando a responsabilidade dos mods especialistas. A deformação e recuperação do terreno estão em desenvolvimento ativo.]]></br>
    </description>
    <iconFilename>icon.dds</iconFilename>
    <multiplayer supported="true"/>
    <l10n>
        <text name="input_RE_PTO_MODE_NEXT">
            <en>PTO: next speed</en>
            <br>PTO: próxima rotação</br>
        </text>
        <text name="input_RE_PTO_MODE_PREV">
            <en>PTO: previous speed</en>
            <br>PTO: rotação anterior</br>
        </text>
        <text name="input_RE_PTO_THROTTLE_UP">
            <en>PTO hand throttle +</en>
            <br>Acelerador manual PTO +</br>
        </text>
        <text name="input_RE_PTO_THROTTLE_DOWN">
            <en>PTO hand throttle -</en>
            <br>Acelerador manual PTO -</br>
        </text>
        <text name="input_RE_PTO_THROTTLE_RESET">
            <en>Release PTO hand throttle</en>
            <br>Liberar acelerador manual PTO</br>
        </text>
    </l10n>

