    <actions>
        <action name="RE_PTO_MODE_NEXT" category="VEHICLE"/>
        <action name="RE_PTO_MODE_PREV" category="VEHICLE"/>
        <action name="RE_PTO_THROTTLE_UP" category="VEHICLE"/>
        <action name="RE_PTO_THROTTLE_DOWN" category="VEHICLE"/>
        <action name="RE_PTO_THROTTLE_RESET" category="VEHICLE"/>
    </actions>

    <inputBinding>
        <actionBinding action="RE_PTO_MODE_NEXT">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_pageup"/>
        </actionBinding>
        <actionBinding action="RE_PTO_MODE_PREV">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_pagedown"/>
        </actionBinding>
        <actionBinding action="RE_PTO_THROTTLE_UP">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_up"/>
        </actionBinding>
        <actionBinding action="RE_PTO_THROTTLE_DOWN">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_down"/>
        </actionBinding>
        <actionBinding action="RE_PTO_THROTTLE_RESET">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_0" index="1"/>
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_KP_0" index="2"/>
        </actionBinding>
    </inputBinding>
</modDesc>
