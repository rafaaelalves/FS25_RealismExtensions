<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<modDesc descVersion="113">
    <author>Realism Extensions</author>
    <version>0.0.1.0</version>
    <title>
        <en>Realism Extensions</en>
        <br>Extensões de Realismo</br>
    </title>
    <description>
        <en><![CDATA[Modular realism extensions that add missing physical and environmental consequences while preserving specialist-mod ownership. This version adds native manual PTO control alongside the existing modular terrain foundation; drivetrain physics and wear remain owned by specialist mods.]]></en>
        <br><![CDATA[Extensões modulares de realismo que adicionam consequências físicas e ambientais ausentes, preservando a responsabilidade dos mods especialistas. Esta versão adiciona controle manual nativo da TDP à fundação modular de terreno, preservando a física da transmissão e o desgaste nos mods especialistas.]]></br>
    </description>
    <iconFilename>icon.dds</iconFilename>
    <multiplayer supported="true"/>
    <l10n>
        <text name="input_RE_PTO_MODE_NEXT">
            <en>PTO: next speed</en>
            <br>PTO: próxima rotação</br>
        </text>
        <text name="input_RE_PTO_MODE_PREV">
            <en>PTO: previous speed</en>
            <br>PTO: rotação anterior</br>
        </text>
        <text name="input_RE_PTO_THROTTLE_UP">
            <en>PTO hand throttle +100 RPM</en>
            <br>Acelerador manual PTO +100 RPM</br>
        </text>
        <text name="input_RE_PTO_THROTTLE_DOWN">
            <en>PTO hand throttle -100 RPM</en>
            <br>Acelerador manual PTO -100 RPM</br>
        </text>
        <text name="input_RE_PTO_THROTTLE_RESET">
            <en>Release PTO hand throttle (ROAD)</en>
            <br>Liberar acelerador manual PTO (ROAD)</br>
        </text>
    </l10n>

    <extraSourceFiles>
        <sourceFile filename="scripts/Config.lua"/>
        <sourceFile filename="scripts/Diagnostics.lua"/>
        <sourceFile filename="scripts/api/StateContract.lua"/>
        <sourceFile filename="scripts/BuildInfo.lua"/>
        <sourceFile filename="scripts/api/PTOContract.lua"/>
        <sourceFile filename="scripts/pto/PTOModel.lua"/>
        <sourceFile filename="scripts/pto/PTOProfiles.lua"/>
        <sourceFile filename="scripts/pto/PTOResolver.lua"/>
        <sourceFile filename="scripts/pto/PTOStateEvent.lua"/>
        <sourceFile filename="scripts/pto/PTOPhysics.lua"/>
        <sourceFile filename="scripts/pto/PTOHUD.lua"/>
        <sourceFile filename="scripts/pto/PTOBootstrap.lua"/>
        <sourceFile filename="scripts/terrain/FootprintModel.lua"/>
        <sourceFile filename="scripts/terrain/SurfaceResponse.lua"/>
        <sourceFile filename="scripts/terrain/TerrainResponseModel.lua"/>
        <sourceFile filename="scripts/terrain/SpatialHistory.lua"/>
        <sourceFile filename="scripts/terrain/TerrainPersistence.lua"/>
        <sourceFile filename="scripts/terrain/SoilMassTransportModel.lua"/>
        <sourceFile filename="scripts/terrain/TerrainPerformance.lua"/>
        <sourceFile filename="scripts/terrain/TerrainWriter.lua"/>
        <sourceFile filename="scripts/terrain/TerrainDeformationRegistration.lua"/>
        <sourceFile filename="scripts/Core.lua"/>
    </extraSourceFiles>
    <actions>
        <action name="RE_PTO_MODE_NEXT" category="VEHICLE"/>
        <action name="RE_PTO_MODE_PREV" category="VEHICLE"/>
        <action name="RE_PTO_THROTTLE_UP" category="VEHICLE"/>
        <action name="RE_PTO_THROTTLE_DOWN" category="VEHICLE"/>
        <action name="RE_PTO_THROTTLE_RESET" category="VEHICLE"/>
    </actions>

    <inputBinding>
        <actionBinding action="RE_PTO_MODE_NEXT">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_pageup"/>
        </actionBinding>
        <actionBinding action="RE_PTO_MODE_PREV">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_pagedown"/>
        </actionBinding>
        <actionBinding action="RE_PTO_THROTTLE_UP">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_up"/>
        </actionBinding>
        <actionBinding action="RE_PTO_THROTTLE_DOWN">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_down"/>
        </actionBinding>
        <actionBinding action="RE_PTO_THROTTLE_RESET">
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_0" index="1"/>
            <binding device="KB_MOUSE_DEFAULT" input="KEY_lctrl KEY_KP_0" index="2"/>
        </actionBinding>
    </inputBinding>
</modDesc>
